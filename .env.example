# ==============================================================================
# CYBORG SUPERMARKET - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment (development | staging | production)
NODE_ENV=development
APP_PORT=3000
APP_HOST=0.0.0.0
API_PREFIX=/api/v1

# Security & Authentication
# Warning: Generate strong 256-bit random secrets in staging and production
JWT_SECRET=cyborg_supermarket_jwt_secret_dev_key_2026_unsecure_local_only
JWT_EXPIRATION=900s
JWT_REFRESH_SECRET=cyborg_supermarket_refresh_dev_key_2026_unsecure_local_only
JWT_REFRESH_EXPIRATION=7d
BCRYPT_SALT_ROUNDS=10

# Database Configuration
# Primary driver: 'sqlite' (local zero-dependency) | 'postgres' (centralized warehouse)
DATABASE_CLIENT=sqlite
DATABASE_FILE=data/cyborg_supermarket.db
DB_PATH=data/cyborg_supermarket.db
SQLITE_BIN=

# PostgreSQL Configuration (used when DATABASE_CLIENT=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cyborg_supermarket
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_safe_dev_password
POSTGRES_SSL=false
POSTGRES_POOL_SIZE=20

# Redis Cache & Event Bus Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=false

# Store Configuration
DEFAULT_STORE_ID=1
DEFAULT_STORE_NAME=Cyborg Hypermarket - Cairo Flagship
DEFAULT_STORE_ADDRESS=Ring Road, New Cairo, Egypt
CURRENCY_CODE=EGP
CURRENCY_SYMBOL=EGP
TAX_RATE_PERCENT=14.0

# POS Terminal Settings
POS_TERMINAL_ID=TERM-01
POS_OFFLINE_STORAGE_PATH=pos_data/pos_offline.db
POS_AUTO_SYNC_INTERVAL_SEC=15

# AI & Voice Engine Configuration
AI_VOICE_PROVIDER=internal
AI_EMBEDDING_PROVIDER=internal
AI_CONFIDENCE_THRESHOLD=0.65
DEFAULT_LANGUAGE=ar-EG
FALLBACK_LANGUAGE=en-US

# External Services (Placeholders for real credentials when procured)
SMS_GATEWAY_PROVIDER=simulated
PAYMENT_GATEWAY_PROVIDER=simulated
WHISPER_API_KEY=
OPENAI_API_KEY=
