# Application Configuration
APP_NAME="Cyborg Supermarket"
APP_VERSION="0.1.0"
DEBUG=True

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite+aiosqlite:///./cyborg.db"
# Production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://cyborg:cyborg_pass@localhost:5432/cyborg_db"

# Redis Cache & Event Bus
REDIS_URL="redis://localhost:6379/0"

# JWT Authentication
JWT_SECRET_KEY="replace-this-with-a-secure-random-secret-in-production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:5173"]
