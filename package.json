{
  "name": "cyborg-supermarket-monorepo",
  "version": "1.0.0",
  "description": "Production-Oriented, AI-Powered Omnichannel Supermarket Ecosystem",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "data:validate": "node scripts/validate-dataset.js",
    "data:report": "node scripts/generate-import-report.js",
    "data:import": "node scripts/import-products.js",
    "start": "node scripts/start-all.js",
    "start:all": "node scripts/start-all.js",
    "start:everything": "bash scripts/start-everything.sh",
    "start:ecosystem": "node scripts/start-all.js --with-voice",
    "start:backend": "node backend/src/standalone-server.js",
    "start:admin": "node admin-dashboard/server.js",
    "start:web": "node customer-website/server.js",
    "start:voice": "python3 features/VOICE/VOICE/app.py",
    "start:gui": "python3 features/data-1/data/supermarket_gui.py",
    "pos:linux": "cd desktop-application && flutter run -d linux",
    "mobile:linux": "cd mobile-application && flutter run -d linux",
    "mobile:app": "cd mobile-application && flutter run -d linux",
    "pos:app": "cd desktop-application && flutter run -d linux",
    "test": "node scripts/run-all-tests.js",
    "test:backend": "node apps/backend/src/scripts/run-backend-tests.js",
    "test:pos": "node scripts/run-pos-tests.js",
    "test:e2e": "node scripts/run-e2e-scenarios.js",
    "test:commercial": "node scripts/run-commercial-tests.js",
    "test:resilience": "node scripts/run-resilience-tests.js",
    "test:ai": "node scripts/evaluate-ai-engine.js",
    "test:backup": "node scripts/verify-backup-restore.js",
    "package:zips": "python scripts/package-zips.py",
    "docs:generate": "python scripts/generate_all_pdfs.py",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {}
}
